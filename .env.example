APP_NAME="SIPUS-Del Perpustakaan Del"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sipus_del
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="perpustakaan@del.ac.id"
MAIL_FROM_NAME="${APP_NAME}"

# Konfigurasi Bisnis SIPUS-Del
CIS_AUTH_MODE=mock
CIS_API_URL=
ADMIN_EMAILS="admin@del.ac.id,pustakawan@del.ac.id"
ADMIN_DEFAULT_PASSWORD=admin123
PERPUSTAKAAN_LAMA_PINJAM=7
PERPUSTAKAAN_MAX_PINJAM=3
PERPUSTAKAAN_TARIF_DENDA=1000
PERPUSTAKAAN_LAMA_PERPANJANG=7

VITE_APP_NAME="${APP_NAME}"